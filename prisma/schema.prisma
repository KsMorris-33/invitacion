// This is your Prisma schema file

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Asistentes {
  id        String   @id @default(uuid())
  email     String   @unique
  nombre    String
  createdAt DateTime @default(now())
}
